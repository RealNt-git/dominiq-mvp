# backend/.env
# Переменные окружения для бэкенда Dominiq MVP
# Версия: соответствует ТЗ Dominiq-MVP-TZ-v1.0

# URL базы данных (SQLite)
DATABASE_URL=sqlite:///./dominiq.db

# Настройки Ollama (локальная LLM)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=phi3:mini

# Параметры генерации
MAX_TOKENS=2048
TEMPERATURE=0.3

# Прочие настройки (можно добавить при необходимости)
# SECRET_KEY=your-secret-key-here  # пока не используется