# backend/.env
# Переменные окружения для бэкенда Dominiq MVP
# Версия: соответствует ТЗ Dominiq-MVP-TZ-v1.0

# URL базы данных (SQLite)
DATABASE_URL=sqlite:///./dominiq.db

# Настройки Ollama (локальная LLM)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=phi3:mini

# Параметры генерации
MAX_TOKENS=2048
TEMPERATURE=0.3

# Прочие настройки (можно добавить при необходимости)
# SECRET_KEY=your-secret-key-here  # пока не используется

#Связь с flows. При создании нужно your-verify-term-flow-id заменять на свой id
LANGFLOW_API_URL=http://langflow:7860/api/v1
LANGFLOW_FLOW_VERIFY_TERM=25e545a4-915c-4fed-8ca1-f49f4d49e2dd
LANGFLOW_FLOW_GENERATE_MNEMONIC=9310d119-a3a6-4d16-bd8c-075d00046fee
LANGFLOW_FLOW_GENERATE_QUESTIONS=1bc67239-4ff6-449f-b0dd-deebd2fece29
LANGFLOW_FLOW_SUGGEST_TOPICS=7de3655a-6996-4305-80f3-5aa6033d69c2
LANGFLOW_FLOW_GENERATE_TOPIC_CONTENT=3c6e1d7f-3af9-4c3c-a6bf-e5ce05d76c06
LANGFLOW_FLOW_DESCRIBE_TOPIC=cdf0dc55-2c7a-4354-b768-13a723c0cdcb